					"name": "Register Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Store token for customer role",
									"if (pm.response.code === 201) {",
									"    pm.collectionVariables.set('customer_token', pm.response.json().token);",
									"    pm.collectionVariables.set('customer_id', pm.response.json().user.id);",
									"    console.log('Customer token saved:', pm.response.json().token);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"demo.customer@delivero.local\",\n    \"password\": \"123456\",\n    \"name\": \"Demo Customer\",\n    \"role\": \"customer\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
